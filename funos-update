#!/bin/bash
set -e

# Must be run as root
if [ "$EUID" -ne 0 ]; then
  echo "This command must be run as root."
  echo "Please run: sudo funos-update"
  exit 1
fi

# Dependency check
command -v jq >/dev/null 2>&1 || {
  echo "Missing dependency: jq"
  echo "Install it with: sudo apt install jq"
  exit 1
}

REPO_URL="https://raw.githubusercontent.com/funos-linux/funos-updates/main"
STATE_DIR="/var/lib/funos-update"
STATE_FILE="$STATE_DIR/applied.json"
TMP_DIR="/tmp/funos-update"

mkdir -p "$STATE_DIR" "$TMP_DIR"

[ -f "$STATE_FILE" ] || echo '{ "applied": [] }' > "$STATE_FILE"

echo "Checking for FunOS updates..."

curl -fsSL "$REPO_URL/updates.json" -o "$TMP_DIR/updates.json"

jq -c '.updates[]' "$TMP_DIR/updates.json" | while read -r update; do
  ID=$(jq -r '.id' <<<"$update")
  DESC=$(jq -r '.description' <<<"$update")
  TYPE=$(jq -r '.type' <<<"$update")
  SOURCE=$(jq -r '.source' <<<"$update")
  TARGET=$(jq -r '.target' <<<"$update")

  if jq -e ".applied[] | select(. == \"$ID\")" "$STATE_FILE" >/dev/null; then
    continue
  fi

  echo
  echo "Update available:"
  echo " - $DESC"
  read -rp "Apply this update? [y/N]: " ANSWER

  [[ "$ANSWER" =~ ^[Yy]$ ]] || continue

  echo "Applying update: $ID"

  WORKDIR="$TMP_DIR/$ID"
  rm -rf "$WORKDIR"
  mkdir -p "$WORKDIR"

  case "$TYPE" in
    wallpaper|jwm-theme)
      ARCHIVE="$TMP_DIR/$ID.tar.gz"
      curl -fsSL "$REPO_URL/$SOURCE.tar.gz" -o "$ARCHIVE"
      tar -xzf "$ARCHIVE" -C "$WORKDIR"

      mkdir -p "$TARGET"
      cp -av "$WORKDIR/"* "$TARGET/"
      ;;
    script)
      curl -fsSL "$REPO_URL/$SOURCE" -o "$WORKDIR/run.sh"
      chmod +x "$WORKDIR/run.sh"
      "$WORKDIR/run.sh"
      ;;
    *)
      echo "Unknown update type: $TYPE"
      continue
      ;;
  esac

  jq ".applied += [\"$ID\"]" "$STATE_FILE" > "$STATE_FILE.tmp"
  mv "$STATE_FILE.tmp" "$STATE_FILE"

  echo "Update applied successfully."
done

echo
echo "FunOS is up to date."
