#!/bin/bash
set -e

# Colors
RED="\033[1;31m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
BLUE="\033[1;34m"
BOLD="\033[1m"
RESET="\033[0m"

# Must run as root
if [ "$EUID" -ne 0 ]; then
    echo -e "${RED}Error:${RESET} Please run this update as root."
    exit 1
fi

REPO_URL="https://raw.githubusercontent.com/funos-linux/funos-updates/main/ubuntu/26.10"
TMP_DIR="/tmp/funos-update"

PLYMOUTH_THEME_DIR="/usr/share/plymouth/themes"
PLYMOUTH_THEME_ARCHIVE="$TMP_DIR/new-update-1-plymouth-theme.tar.gz"
FUNOS_THEME_DIR="$PLYMOUTH_THEME_DIR/funos-bgrt"

echo -e "${BOLD}${BLUE}== FunOS Update: Step 1 ==${RESET}"

mkdir -p "$TMP_DIR"

#
# Plymouth theme
#
echo -e "${BLUE}→ Installing Plymouth theme...${RESET}"

curl -fsSL "$REPO_URL/update-1/new-update-1-plymouth-theme.tar.gz" -o "$PLYMOUTH_THEME_ARCHIVE"

rm -rf "$FUNOS_THEME_DIR"
tar -xzf "$PLYMOUTH_THEME_ARCHIVE" -C "$PLYMOUTH_THEME_DIR" --no-same-owner
rm -f "$PLYMOUTH_THEME_ARCHIVE"

if [ ! -f "$FUNOS_THEME_DIR/funos-bgrt.plymouth" ]; then
    echo -e "${RED}Error:${RESET} funos-bgrt Plymouth theme not found after extraction."
    exit 1
fi

update-alternatives --install \
    /usr/share/plymouth/themes/default.plymouth \
    default.plymouth \
    "$FUNOS_THEME_DIR/funos-bgrt.plymouth" \
    250

update-alternatives --set \
    default.plymouth \
    "$FUNOS_THEME_DIR/funos-bgrt.plymouth"

update-initramfs -u

echo -e "${GREEN}✔ Plymouth theme applied.${RESET}"

#
# Divert nm-tray.desktop
#
echo -e "${BLUE}→ Diverting nm-tray.desktop to keep it hidden from the application menu...${RESET}"

DESKTOP_FILE="/usr/share/applications/nm-tray.desktop"
DIVERTED_FILE="/usr/share/applications/nm-tray.desktop.real"

# Register the diversion if not already diverted
if ! dpkg-divert --list "$DESKTOP_FILE" | grep -q "$DESKTOP_FILE"; then
    dpkg-divert --add --rename --divert "$DIVERTED_FILE" "$DESKTOP_FILE"
fi

# Create the custom desktop entry with NoDisplay=true
cat << 'EOF' > "$DESKTOP_FILE"
[Desktop Entry]
Type=Application
Name=nm-tray
Comment=NetworkManager frontend (tray icon)
Icon=network-transmit
TryExec=nm-tray
Exec=nm-tray
Categories=System;Monitor;Qt;
NoDisplay=true
EOF
chmod 644 "$DESKTOP_FILE"

# Refresh application desktop database cache if available
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
fi

echo -e "${GREEN}✔ nm-tray.desktop diverted and hidden from application menu.${RESET}"

#
# Mozilla Team PPA update
#
echo -e "${BLUE}→ Updating Mozilla Team PPA...${RESET}"

rm -f /etc/apt/sources.list.d/mozillateam-ubuntu-ppa-resolute.sources
rm -f /etc/apt/sources.list.d/mozillateam-ubuntu-ppa-questing.sources
rm -f /etc/apt/sources.list.d/mozillateam-ubuntu-ppa-noble.sources
add-apt-repository ppa:mozillateam/ppa -y || true
apt update || true

echo -e "${GREEN}✔ Mozilla Team PPA updated.${RESET}"

#
# Remove unused desktop entries
#
echo -e "${BLUE}→ Removing unused desktop entries...${RESET}"

rm -f /usr/share/applications/pcmanfm-desktop-pref.desktop
rm -f /usr/share/applications/info.desktop
rm -f /usr/share/applications/vim.desktop

echo -e "${GREEN}✔ Unused desktop entries removed.${RESET}"
