#!/bin/bash
set -e

REPO_URL="https://raw.githubusercontent.com/funos-linux/funos-updates/main/ubuntu/24.04"
STATE_DIR="/var/lib/funos-update"
STATE_FILE="$STATE_DIR/update-version.txt"
TMP_DIR="/tmp/funos-update"
TMP_VERSION_FILE="$TMP_DIR/update-version.txt"

# Must run as root
if [ "$EUID" -ne 0 ]; then
    echo "Please run as root"
    exit 1
fi

# Ensure cleanup on exit or error
cleanup() {
    rm -rf "$TMP_DIR"
}
trap cleanup EXIT

# Ensure directories exist
mkdir -p "$STATE_DIR"
mkdir -p "$TMP_DIR"

# Ensure local state file exists
[ ! -f "$STATE_FILE" ] && echo 0 > "$STATE_FILE"

# Download remote update version file
echo "Checking for updates..."
curl -fsSL "$REPO_URL/update-version.txt" -o "$TMP_VERSION_FILE"

# Read versions
LOCAL_VERSION=$(<"$STATE_FILE")
REMOTE_VERSION=$(<"$TMP_VERSION_FILE")

# Ensure numeric values
if ! [[ "$LOCAL_VERSION" =~ ^[0-9]+$ && "$REMOTE_VERSION" =~ ^[0-9]+$ ]]; then
    echo "Invalid version number"
    exit 1
fi

# Compare versions
if [ "$LOCAL_VERSION" -eq "$REMOTE_VERSION" ]; then
    echo "No updates available"
    exit 0
fi

if [ "$LOCAL_VERSION" -gt "$REMOTE_VERSION" ]; then
    echo "Local version is newer than remote version (unexpected)"
    exit 1
fi

echo "Update available"
echo "Updating from version $LOCAL_VERSION to $REMOTE_VERSION"

# Run updates incrementally
for (( i=LOCAL_VERSION+1; i<=REMOTE_VERSION; i++ )); do
    UPDATE_FILE="new-update-$i"
    UPDATE_PATH="$TMP_DIR/$UPDATE_FILE"

    echo "Downloading $UPDATE_FILE..."
    curl -fsSL "$REPO_URL/$UPDATE_FILE" -o "$UPDATE_PATH"

    chmod +x "$UPDATE_PATH"

    echo "Running $UPDATE_FILE..."
    "$UPDATE_PATH"

    echo "Update $i completed"
done

# Update local version only after success
echo "$REMOTE_VERSION" > "$STATE_FILE"

echo "System successfully updated to version $REMOTE_VERSION"
