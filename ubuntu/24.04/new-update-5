#
# Update wallpapers
#
echo -e "${BLUE}→ Updating wallpapers...${RESET}"

if [ ! -f "$WALLPAPER_DIR/01-fuji-lake-sunset.jpg" ]; then
    mkdir -p "$WALLPAPER_DIR"
    curl -fL -# "$REPO_URL/update-5/new-update-5-wallpaper.tar.gz.partaa" -o "${WALLPAPER_ARCHIVE}.partaa"
    curl -fL -# "$REPO_URL/update-5/new-update-5-wallpaper.tar.gz.partab" -o "${WALLPAPER_ARCHIVE}.partab"
    
    cat "${WALLPAPER_ARCHIVE}.partaa" "${WALLPAPER_ARCHIVE}.partab" > "$WALLPAPER_ARCHIVE"
    tar -xzvf "$WALLPAPER_ARCHIVE" -C "$WALLPAPER_DIR" --no-same-owner
    rm -f "$WALLPAPER_ARCHIVE" "${WALLPAPER_ARCHIVE}.partaa" "${WALLPAPER_ARCHIVE}.partab"
fi

echo -e "${GREEN}✔ Wallpapers updated.${RESET}"

#
# Remove funos-spinner plymouth theme
#
echo -e "${BLUE}→ Removing old funos-spinner theme...${RESET}"

rm -rf "/usr/share/plymouth/themes/funos-spinner"

echo -e "${GREEN}✔ Old plymouth theme removed.${RESET}"

#
# Delete unused desktop entries
#
echo -e "${BLUE}→ Removing unused desktop entries...${RESET}"

rm -f /usr/share/applications/pcmanfm-desktop-pref.desktop
rm -f /usr/share/applications/info.desktop
rm -f /usr/share/applications/vim.desktop

echo -e "${GREEN}✔ Unused desktop entries removed.${RESET}"

#
# Install required packages
#
echo -e "${BLUE}→ Installing required packages...${RESET}"

apt-get update
apt-get install -y \
    curl \
    apt-transport-https \
    libfuse2 \
    lightdm-gtk-greeter-settings \
    numix-gtk-theme \
    numix-icon-theme \
    papirus-icon-theme \
    fonts-noto-core \
    fonts-dejavu-core

echo -e "${GREEN}✔ Required packages installed.${RESET}"

#
# Remove unused packages
#
echo -e "${BLUE}→ Removing unused packages...${RESET}"

apt-get remove -y --purge system-tools-backends gnome-system-tools || true
apt-get autoremove -y

echo -e "${GREEN}✔ Unused packages removed.${RESET}"

#
# Update GTK 2.0 settings
#
echo -e "${BLUE}→ Updating GTK 2.0 settings...${RESET}"

if ! grep -q 'gtk-theme-name="Numix"' /etc/gtk-2.0/gtkrc 2>/dev/null; then
    mkdir -p /etc/gtk-2.0
    cat > /etc/gtk-2.0/gtkrc << 'EOF'
gtk-theme-name="Numix"
gtk-icon-theme-name="Numix"
gtk-font-name="Sans 10"
gtk-cursor-theme-name="Adwaita"
gtk-cursor-theme-size=0
gtk-toolbar-style=GTK_TOOLBAR_BOTH
gtk-toolbar-icon-size=GTK_ICON_SIZE_LARGE_TOOLBAR
gtk-button-images=1
gtk-menu-images=1
gtk-enable-event-sounds=1
gtk-enable-input-feedback-sounds=1
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle="hintmedium"
gtk-xft-rgba="rgb"
EOF
fi

echo -e "${GREEN}✔ GTK 2.0 settings updated.${RESET}"

#
# Update GTK 3.0 settings
#
echo -e "${BLUE}→ Updating GTK 3.0 settings...${RESET}"

mkdir -p /etc/xdg/gtk-3.0
cat > /etc/xdg/gtk-3.0/settings.ini << 'EOF'
[Settings]
gtk-theme-name=Numix
gtk-icon-theme-name=Numix
gtk-font-name=Sans 10
gtk-cursor-theme-name=Adwaita
gtk-cursor-theme-size=0
gtk-toolbar-style=GTK_TOOLBAR_BOTH
gtk-toolbar-icon-size=GTK_ICON_SIZE_LARGE_TOOLBAR
gtk-button-images=1
gtk-menu-images=1
gtk-enable-event-sounds=1
gtk-enable-input-feedback-sounds=1
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle=hintmedium
gtk-xft-rgba=rgb
EOF

echo -e "${GREEN}✔ GTK 3.0 settings updated.${RESET}"

#
# Configure LightDM greeter
#
echo -e "${BLUE}→ Configuring LightDM greeter...${RESET}"

mkdir -p /etc/lightdm/lightdm-gtk-greeter.conf.d
cat > /etc/lightdm/lightdm-gtk-greeter.conf.d/50_funos.conf << 'EOF'
[greeter]
background = /opt/artwork/wallpaper/98-synthwave-horizon.png
theme-name = Numix
icon-theme-name = Papirus
EOF

echo -e "${GREEN}✔ LightDM greeter configured.${RESET}"

#
# Check and update main LightDM config if needed
#
if [ -f /etc/lightdm/lightdm-gtk-greeter.conf ]; then
    for old_wp in "${OLD_WALLPAPERS[@]}"; do
        if grep -q "^[[:space:]]*background.*$old_wp" /etc/lightdm/lightdm-gtk-greeter.conf; then
            sed -i 's|^[[:space:]]*background[[:space:]]*=.*|background = /opt/artwork/wallpaper/98-synthwave-horizon.png|' /etc/lightdm/lightdm-gtk-greeter.conf
            echo -e "${YELLOW}  Updated old background in lightdm-gtk-greeter.conf${RESET}"
            break
        fi
    done
fi

#
# Fix Netplan config extension
#
echo -e "${BLUE}→ Checking Netplan config extension...${RESET}"

if [ -f /etc/netplan/01-network-manager-all.yml ]; then
    mv /etc/netplan/01-network-manager-all.yml /etc/netplan/01-network-manager-all.yaml
fi

echo -e "${GREEN}✔ Netplan config checked.${RESET}"

#
# Update user configs (JWM and Nitrogen)
#
echo -e "${BLUE}→ Checking user configs (JWM and Nitrogen)...${RESET}"

VALID_WALLPAPERS=(
"01-fuji-lake-sunset.jpg" "02-kyoto-yasaka-street.jpg" "03-fuji-lake-autumn.jpg"
