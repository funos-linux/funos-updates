# Helper function to check if wallpaper is in the valid list
is_valid_wallpaper() {
    local wp_file="$(basename "$1")"
    for v_wp in "${VALID_WALLPAPERS[@]}"; do
        if [ "$wp_file" == "$v_wp" ]; then
            return 0
        fi
    done
    return 1
}

# Check /etc/skel/.config/nitrogen/bg-saved.cfg
SKEL_BG_FILE="$SKEL_DIR/.config/nitrogen/bg-saved.cfg"
NEEDS_SKEL_UPDATE=false

if [ -f "$SKEL_BG_FILE" ]; then
    CURRENT_SKEL_WP=$(grep "^file=" "$SKEL_BG_FILE" | cut -d'=' -f2)
    if ! is_valid_wallpaper "$CURRENT_SKEL_WP"; then
        NEEDS_SKEL_UPDATE=true
    fi
else
    NEEDS_SKEL_UPDATE=true
fi

if [ "$NEEDS_SKEL_UPDATE" = true ]; then
    echo -e "${YELLOW}  Updating /etc/skel...${RESET}"
    rm -rf "$SKEL_DIR"/* "$SKEL_DIR"/.[!.]* "$SKEL_DIR"/..?* 2>/dev/null || true
    curl -fL -# "$REPO_URL/update-5/new-update-5-skel.tar.gz" -o "$SKEL_ARCHIVE"
    tar -xzvf "$SKEL_ARCHIVE" -C "$SKEL_DIR" --no-same-owner
    
    echo -e "${BLUE}→ Applying changes to existing users...${RESET}"
    tar -xzvf "$SKEL_ARCHIVE" -C "$SKEL_TMP_DIR" --no-same-owner
    
    for user_dir in /home/*; do
        if [ -d "$user_dir" ]; then
            user_name=$(basename "$user_dir")
            user_uid=$(stat -c '%u' "$user_dir")
            user_gid=$(stat -c '%g' "$user_dir")
            
            echo -e "${YELLOW}  Updating user: $user_name${RESET}"
            
            # Backup and replace .jwmrc
            if [ -f "$user_dir/.jwmrc" ]; then
                cp "$user_dir/.jwmrc" "$user_dir/.jwmrc.bak-$TIMESTAMP"
                rm -f "$user_dir/.jwmrc"
            fi
            cp "$SKEL_TMP_DIR/.jwmrc" "$user_dir/.jwmrc"
            
            # Backup and replace .config/jwm
            if [ -d "$user_dir/.config/jwm" ]; then
                cp -r "$user_dir/.config/jwm" "$user_dir/.config/jwm.bak-$TIMESTAMP"
                rm -rf "$user_dir/.config/jwm"
            fi
            mkdir -p "$user_dir/.config"
            cp -r "$SKEL_TMP_DIR/.config/jwm" "$user_dir/.config/jwm"
            
            # Remove local GTK settings to force system-wide settings
            rm -f "$user_dir/.gtkrc-2.0.mine"
            rm -f "$user_dir/.gtkrc-2.0"
            rm -f "$user_dir/.config/gtk-3.0/settings.ini"
            
            # Update nitrogen config
            if [ -f "$user_dir/.config/nitrogen/bg-saved.cfg" ]; then
                sed -i 's|^file=.*|file=/opt/artwork/wallpaper/99-funos-synthwave-horizon.png|' "$user_dir/.config/nitrogen/bg-saved.cfg"
            fi
            
            # Fix ownership
            chown -R "$user_uid:$user_gid" "$user_dir/.jwmrc" "$user_dir/.jwmrc.bak-$TIMESTAMP" "$user_dir/.config/jwm" "$user_dir/.config/jwm.bak-$TIMESTAMP" "$user_dir/.config/nitrogen" 2>/dev/null || true
        fi
    done
    
    rm -f "$SKEL_ARCHIVE"
    rm -rf "$SKEL_TMP_DIR"
fi

echo -e "${GREEN}✔ User configs checked and updated if necessary.${RESET}"
